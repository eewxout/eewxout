abstract class Vehicle {
    constructor (public brand: string) {}
        abstract start(): void

        private static totalCount = 0;

        static getCount(): number {
            return this.totalCount
        }
        static create(ctor: new (brand: string) => Vehicle, brand: string): Vehicle {
            this.totalCount++
            return new ctor (brand); 
        }
}

class Car extends Vehicle {
    override start(): void {
        console.log(`${this.brand} car engine started`)
    }
}

class Motorcycle extends Vehicle {
    override start(): void {
        console.log(`${this.brand} motorcycle engine started`)
    }
}

const vehicles: Vehicle[] = [
    //при статике 
    Vehicle.create(Car,'Tayota'),
    Vehicle.create(Motorcycle,'Yamaha'),
];
console.log(vehicles)
console.log(Vehicle.getCount(),`\n\n\n`)
